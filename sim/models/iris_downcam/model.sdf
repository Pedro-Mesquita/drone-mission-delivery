<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    The ArduPilot iris with a camera fixed under the body, looking down.
    Image top = nose, image right = right side, like the real drone.
    Camera Module 3 settings: 1280x720, horizontal FOV 66 degrees.
  -->
  <model name="iris_downcam">
    <include>
      <uri>model://iris_with_ardupilot</uri>
      <name>iris</name>
    </include>

    <link name="camera_link">
      <pose>0 0 -0.08 0 1.5708 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="down_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <topic>mission/cam</topic>
        <camera>
          <horizontal_fov>1.1519</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>iris::iris_with_standoffs::base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
